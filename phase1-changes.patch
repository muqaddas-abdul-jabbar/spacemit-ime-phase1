diff --git a/llvm/include/llvm/IR/IntrinsicsRISCVXSpacemit.td b/llvm/include/llvm/IR/IntrinsicsRISCVXSpacemit.td
new file mode 100644
index 000000000000..e824edea59aa
--- /dev/null
+++ b/llvm/include/llvm/IR/IntrinsicsRISCVXSpacemit.td
@@ -0,0 +1,19 @@
+//===- IntrinsicsRISCVXSpacemit.td - SpacemiT intrinsics -*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file defines all of the SpacemiT-specific intrinsics.
+//
+//===----------------------------------------------------------------------===//
+
+let TargetPrefix = "riscv" in {
+  // SpacemiT Vector Dot Product Extension (XSMTVDot)
+  defm smt_vmadot   : RISCVTernaryWide;
+  defm smt_vmadotu  : RISCVTernaryWide;
+  defm smt_vmadotsu : RISCVTernaryWide;
+  defm smt_vmadotus : RISCVTernaryWide;
+} // TargetPrefix = "riscv"
diff --git a/llvm/lib/Target/RISCV/RISCVFeatures.td b/llvm/lib/Target/RISCV/RISCVFeatures.td
index 2abc78ff874c..47e2e8bc817d 100644
--- a/llvm/lib/Target/RISCV/RISCVFeatures.td
+++ b/llvm/lib/Target/RISCV/RISCVFeatures.td
@@ -1566,6 +1566,17 @@ def FeatureVendorXSfsclic
     : RISCVExperimentalExtension<0, 1,
                                  "SiFive CLIC Supervisor-mode CSRs">;
 
+// SpacemiT Extensions
+
+def FeatureVendorXSpacemitIme
+    : RISCVExtension<1, 0,
+                      "SpacemiT Integer Matrix Extension (IME)",
+                      [FeatureStdExtZve32x]>;
+def HasVendorXSpacemitIme
+    : Predicate<"Subtarget->hasVendorXSpacemitIme()">,
+      AssemblerPredicate<(all_of FeatureVendorXSpacemitIme),
+                         "'XSpacemitIme' (SpacemiT Integer Matrix Extension)">;
+
 // Core-V Extensions
 
 def FeatureVendorXCVelw
diff --git a/llvm/lib/Target/RISCV/RISCVInstrInfoXSpacemiT.td b/llvm/lib/Target/RISCV/RISCVInstrInfoXSpacemiT.td
index 2e51186360ae..3760bf64a69a 100644
--- a/llvm/lib/Target/RISCV/RISCVInstrInfoXSpacemiT.td
+++ b/llvm/lib/Target/RISCV/RISCVInstrInfoXSpacemiT.td
@@ -109,3 +109,37 @@ let DecoderNamespace = "XSMT" in {
     }
   }
 } // DecoderNamespace = "XSMT"
+
+//===----------------------------------------------------------------------===//
+// Patterns: connect the Clang/LLVM-IR intrinsics (int_riscv_smt_vmadot*) to
+// the real hardware instructions defined above (SMT_VMADOT*).
+//
+// SMT_VMADOT* take a fixed LMUL=2 accumulator (VRM2, e.g. vint32m2_t) and two
+// LMUL=1 operands (VR, e.g. vint8m1_t) -- this matches VLEN=256, SEW=8,
+// vl*SEW=256 exactly as required by Phase 1 (see task spec). Because the
+// real instructions use fixed register classes (not LMUL-parameterized
+// pseudo-multiclasses like standard RVV ops), we pattern-match directly
+// instead of going through the VPseudoTernaryW_VV/VPatTernaryW_VV machinery.
+//===----------------------------------------------------------------------===//
+let Predicates = [HasVendorXSMTVDot, IsRV64] in {
+  def : Pat<(vint32m2_t (int_riscv_smt_vmadot (vint32m2_t VRM2:$vd),
+                                              (vint8m1_t VR:$vs1),
+                                              (vint8m1_t VR:$vs2),
+                                              (XLenVT srcvalue), (XLenVT srcvalue))),
+            (SMT_VMADOT VRM2:$vd, VR:$vs1, VR:$vs2)>;
+  def : Pat<(vint32m2_t (int_riscv_smt_vmadotu (vint32m2_t VRM2:$vd),
+                                               (vint8m1_t VR:$vs1),
+                                               (vint8m1_t VR:$vs2),
+                                               (XLenVT srcvalue), (XLenVT srcvalue))),
+            (SMT_VMADOTU VRM2:$vd, VR:$vs1, VR:$vs2)>;
+  def : Pat<(vint32m2_t (int_riscv_smt_vmadotsu (vint32m2_t VRM2:$vd),
+                                                (vint8m1_t VR:$vs1),
+                                                (vint8m1_t VR:$vs2),
+                                                (XLenVT srcvalue), (XLenVT srcvalue))),
+            (SMT_VMADOTSU VRM2:$vd, VR:$vs1, VR:$vs2)>;
+  def : Pat<(vint32m2_t (int_riscv_smt_vmadotus (vint32m2_t VRM2:$vd),
+                                                (vint8m1_t VR:$vs1),
+                                                (vint8m1_t VR:$vs2),
+                                                (XLenVT srcvalue), (XLenVT srcvalue))),
+            (SMT_VMADOTUS VRM2:$vd, VR:$vs1, VR:$vs2)>;
+}
