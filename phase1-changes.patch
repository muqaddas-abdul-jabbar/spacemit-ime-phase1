+  %r = call <vscale x 4 x i32> @llvm.riscv.smt.vmadot.nxv4i32.nxv8i8.nxv8i8.i64(
+        <vscale x 4 x i32> %vd, <vscale x 8 x i8> %vs1,
+        <vscale x 8 x i8> %vs2, i64 %vl, i64 3)
+  ret <vscale x 4 x i32> %r
+}
